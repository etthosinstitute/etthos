# Database
DATABASE_URL="postgresql://user:password@localhost:5434/journal"

# Public origin of the journal. Used for email links and canonical URLs.
APP_URL="https://etthosjournal.com"

# Auth. Must be at least 32 characters.
JWT_SECRET=""

# Send auth cookies with the Secure flag. Defaults to true when APP_URL is https.
AUTH_COOKIE_SECURE="true"

# Outgoing mail
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER=""
EMAIL_PASS=""
REVIEW_INBOX_EMAIL=""
CONTACT_INBOX_EMAIL=""

# Manuscript uploads. Absolute path served by the reverse proxy at /uploads.
# Falls back to <app>/public/uploads/manuscripts when unset.
UPLOAD_DIR="/var/www/etthos-uploads/manuscripts"
MAX_UPLOAD_MB="10"

# Credentials used by scripts/seed.ts. Required to run the seed, minimum 12
# characters. Never commit real values.
SEED_EDITOR_EMAIL="editor@journal.com"
SEED_EDITOR_PASSWORD=""
SEED_REVIEWER_EMAIL="reviewer@journal.com"
SEED_REVIEWER_PASSWORD=""
