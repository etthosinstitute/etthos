// Prisma Schema for Etthos Journal System
// Database: PostgreSQL
// Fully ISSN India compliant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE JOURNAL STRUCTURE
// ============================================================================

// Singleton journal configuration
model Journal {
  id          String   @id @default(cuid())
  name        String   @default("Etthos Journal of Psychology")
  shortName   String   @default("EJP")
  description String?
  issn        String?  @unique // Once obtained from ISSN India
  eissn       String?  @unique // Electronic ISSN
  publisher   String   @default("Etthos")
  frequency   String   @default("Quarterly") // Quarterly, Bi-annual, etc.
  language    String   @default("English")
  country     String   @default("India")
  
  // Contact & Publisher Info (ISSN Requirement)
  publisherAddress String
  publisherCity    String
  publisherState   String
  publisherCountry String
  publisherZip     String
  contactEmail     String
  contactPhone     String?
  
  // URLs
  websiteUrl      String @default("https://journal.etthos.com")
  mainWebsiteUrl  String @default("https://etthos.com")
  
  // Subject Classification
  subjectArea     String @default("Psychology")
  subjectKeywords String[] // ["Clinical Psychology", "Cognitive Psychology", etc.]
  
  // Settings
  articlesPerIssue Int    @default(5) // Minimum for ISSN compliance
  isActive         Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  volumes Volume[]
  
  @@map("journals")
}

// Volume (typically one per year)
model Volume {
  id          String   @id @default(cuid())
  number      Int      // 1, 2, 3, etc.
  year        Int      // 2024, 2025, etc.
  description String?
  
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  
  issues Issue[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([journalId, number])
  @@unique([journalId, year])
  @@index([journalId, year])
  @@map("volumes")
}

// Issue (multiple per volume)
model Issue {
  id          String   @id @default(cuid())
  number      Int      // 1, 2, 3, etc.
  title       String?  // "Special Issue on Trauma Psychology"
  description String?
  
  // Publication Info
  published      Boolean  @default(false)
  publishedDate  DateTime?
  coverImageUrl  String?  // Issue cover image
  
  volumeId String
  volume   Volume @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  
  articles Article[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([volumeId, number])
  @@index([volumeId])
  @@index([published, publishedDate])
  @@map("issues")
}

// ============================================================================
// ARTICLE SYSTEM (ISSN Compliant)
// ============================================================================

model Article {
  id    String @id @default(cuid())
  
  // Basic Info
  title    String
  slug     String @unique // URL-friendly: "cognitive-behavioral-therapy-study"
  abstract String // 150-300 words
  
  // Article Type
  type ArticleType @default(RESEARCH_ARTICLE)
  
  // Publication Info
  published      Boolean   @default(false)
  publishedDate  DateTime?
  submittedDate  DateTime?
  acceptedDate   DateTime?
  
  // Page Numbers (for print/citation)
  pageStart Int?
  pageEnd   Int?
  
  // DOI (Digital Object Identifier)
  doi String? @unique // Format: 10.xxxxx/etthos.v1i1.001
  
  // PDF & Files
  pdfUrl             String? // Vercel Blob URL
  pdfSize            Int?    // in bytes
  supplementaryFiles Json?   // Array of additional files
  
  // Content
  fullText String? // Optional: full HTML text
  
  // Metrics
  views        Int @default(0)
  downloads    Int @default(0)
  
  // Funding & Declarations
  fundingInfo           String?
  conflictOfInterest    String?
  acknowledgments       String?
  dataAvailability      String?
  ethicsApproval        String?
  
  // Relationships
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  authors        ArticleAuthor[] // Many-to-many through join table
  keywords       ArticleKeyword[] // Many-to-many through join table
  references     Reference[]
  citations      Citation[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([slug])
  @@index([issueId])
  @@index([published, publishedDate])
  @@index([type])
  @@fulltext([title, abstract]) // Full-text search
  @@map("articles")
}

enum ArticleType {
  RESEARCH_ARTICLE
  REVIEW_ARTICLE
  CASE_STUDY
  SHORT_COMMUNICATION
  EDITORIAL
  LETTER_TO_EDITOR
  BOOK_REVIEW
}

// ============================================================================
// AUTHORS & AFFILIATIONS
// ============================================================================

model Author {
  id String @id @default(cuid())
  
  // Personal Info
  firstName   String
  lastName    String
  middleName  String?
  email       String  @unique
  orcid       String? @unique // ORCID ID: 0000-0002-1234-5678
  
  // Professional Info
  title       String? // Dr., Prof., etc.
  biography   String?
  website     String?
  
  // Contact
  phone       String?
  
  // Profile
  profileImageUrl String?
  
  // Relationships
  articles      ArticleAuthor[]
  affiliations  AuthorAffiliation[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
  @@index([orcid])
  @@map("authors")
}

model Affiliation {
  id String @id @default(cuid())
  
  // Institution Info
  institution String  // "University of Delhi"
  department  String? // "Department of Psychology"
  
  // Location
  city     String
  state    String?
  country  String
  
  // Additional
  website  String?
  
  authors AuthorAffiliation[]
  boardMembers EditorialBoardMember[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([institution, department, city, country])
  @@map("affiliations")
}

// Join table: Author <-> Affiliation (many-to-many)
model AuthorAffiliation {
  id String @id @default(cuid())
  
  authorId      String
  author        Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  affiliationId String
  affiliation   Affiliation @relation(fields: [affiliationId], references: [id], onDelete: Cascade)
  
  isPrimary Boolean @default(false)
  position  String? // "Research Fellow", "Professor", etc.
  
  startDate DateTime?
  endDate   DateTime?
  current   Boolean @default(true)
  
  @@unique([authorId, affiliationId])
  @@map("author_affiliations")
}

// Join table: Article <-> Author (many-to-many with order)
model ArticleAuthor {
  id String @id @default(cuid())
  
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  authorId String
  author   Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  order              Int     // 1, 2, 3 (author order)
  isCorresponding    Boolean @default(false)
  correspondingEmail String?
  
  // Affiliation at time of publication
  affiliationAtPublication String?
  
  @@unique([articleId, authorId])
  @@unique([articleId, order])
  @@index([articleId])
  @@index([authorId])
  @@map("article_authors")
}

// ============================================================================
// KEYWORDS
// ============================================================================

model Keyword {
  id   String @id @default(cuid())
  name String @unique
  
  articles ArticleKeyword[]
  
  createdAt DateTime @default(now())
  
  @@index([name])
  @@map("keywords")
}

// Join table: Article <-> Keyword
model ArticleKeyword {
  id String @id @default(cuid())
  
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  
  @@unique([articleId, keywordId])
  @@index([articleId])
  @@index([keywordId])
  @@map("article_keywords")
}

// ============================================================================
// REFERENCES & CITATIONS
// ============================================================================

model Reference {
  id String @id @default(cuid())
  
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  // Reference details
  order       Int    // Order in reference list
  text        String // Full citation text
  doi         String?
  pmid        String? // PubMed ID
  url         String?
  
  // Structured data (optional)
  authors     String?
  title       String?
  journal     String?
  year        Int?
  volume      String?
  issue       String?
  pages       String?
  
  @@unique([articleId, order])
  @@index([articleId])
  @@map("references")
}

// Citation formats for each article
model Citation {
  id String @id @default(cuid())
  
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  format CitationFormat
  text   String
  
  @@unique([articleId, format])
  @@map("citations")
}

enum CitationFormat {
  APA
  MLA
  CHICAGO
  HARVARD
  IEEE
  BIBTEX
  RIS
}

// ============================================================================
// EDITORIAL BOARD (ISSN Requirement: Minimum 5 members)
// ============================================================================

model EditorialBoardMember {
  id String @id @default(cuid())
  
  // Personal Info (ISSN Requirements)
  firstName String
  lastName  String
  title     String? // Dr., Prof.
  email     String  @unique // Must be official institutional email
  
  // Role
  role        BoardRole
  position    String?   // Custom position title
  
  // Professional Info (ISSN Requirements)
  designation String    // Professor, Associate Professor, etc.
  department  String    // Department of Psychology
  
  affiliationId String
  affiliation   Affiliation @relation(fields: [affiliationId], references: [id])
  
  // Additional Info
  country         String
  orcid           String?
  biography       String?
  expertise       String[] // Areas of expertise
  profileImageUrl String?
  website         String?
  
  // Display
  displayOrder Int       // Order on editorial board page
  isActive     Boolean   @default(true)
  
  // Dates
  joinedDate DateTime   @default(now())
  endDate    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([role])
  @@index([isActive, displayOrder])
  @@map("editorial_board")
}

enum BoardRole {
  EDITOR_IN_CHIEF
  MANAGING_EDITOR
  ASSOCIATE_EDITOR
  SECTION_EDITOR
  EDITORIAL_BOARD_MEMBER
  REVIEWER
}

// ============================================================================
// USER MANAGEMENT (for Admin Dashboard)
// ============================================================================

model User {
  id String @id @default(cuid())
  
  email     String   @unique
  password  String   // Hashed
  firstName String?
  lastName  String?
  role      UserRole @default(VIEWER)
  
  isActive Boolean @default(true)
  
  // Activity tracking
  lastLoginAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN  // Full access
  ADMIN        // Can manage content
  EDITOR       // Can edit articles
  VIEWER       // Read-only access
}

