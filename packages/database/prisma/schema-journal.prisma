// ============================================================================
// ANALYTICS & METRICS
// ============================================================================

model ArticleView {
  id String @id @default(cuid())
  
  articleId String
  
  // Visitor info (anonymized)
  ipHash     String  // Hashed IP for privacy
  userAgent  String?
  country    String?
  referrer   String?
  
  viewedAt DateTime @default(now())
  
  @@index([articleId, viewedAt])
  @@map("article_views")
}

model ArticleDownload {
  id String @id @default(cuid())
  
  articleId String
  
  // Visitor info (anonymized)
  ipHash     String
  userAgent  String?
  country    String?
  
  downloadedAt DateTime @default(now())
  
  @@index([articleId, downloadedAt])
  @@map("article_downloads")
}
